current_branch=$(git rev-parse --abbrev-ref HEAD)
temporary_branch="auto/$current_branch/pre-push/$(date +%s)"

# Snapshot both staged (index) and unstaged (working tree) changes as commits
git checkout -b "$temporary_branch"

git commit --no-verify --allow-empty -m "auto/pre-push(index)"
git add .
git commit --no-verify --allow-empty -m "auto/pre-push(working tree)"

# Return to original branch and run validations
git checkout "$current_branch"

# Run tests and capture exit code without stopping the script
npm run test
tests_code=$?

# Restore working state from the temporary branch, then clean it up
git checkout "$temporary_branch"
git reset --mixed HEAD^
git reset --soft HEAD^

git checkout "$current_branch"
git branch -D "$temporary_branch"

exit "$tests_code"
